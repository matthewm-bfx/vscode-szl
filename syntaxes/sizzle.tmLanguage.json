{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Sizzle",
    "scopeName": "source.szl",
    "patterns": [
        { "include": "#exporter" },
        { "include": "#header" },
        { "include": "#code" }
    ],
    "repository": {
        "exporter": {
            "comment": "Exporters start in boilerplate (literal text) mode after the header line, until the first @[",
            "begin": "\\A(?=//SIZZLEX\\b)",
            "end": "@\\[",
            "endCaptures": { "0": { "name": "punctuation.section.embedded.begin.szl" } },
            "contentName": "string.unquoted.boilerplate.szl",
            "patterns": [{ "include": "#header" }]
        },
        "header": {
            "match": "\\A(//)(SIZZLE[ITX])\\b.*$",
            "name": "comment.line.double-slash.header.szl",
            "captures": {
                "1": { "name": "punctuation.definition.comment.szl" },
                "2": { "name": "keyword.other.directive.szl" }
            }
        },
        "code": {
            "patterns": [
                { "include": "#comment" },
                { "include": "#boilerplate" },
                { "include": "#string" },
                { "include": "#number" },
                { "include": "#function-definition" },
                { "include": "#keyword" },
                { "include": "#constant" },
                { "include": "#builtin" },
                { "include": "#function-call" },
                { "include": "#member" },
                { "include": "#operator" },
                { "include": "#punctuation" }
            ]
        },
        "comment": {
            "match": "(//).*$",
            "name": "comment.line.double-slash.szl",
            "captures": { "1": { "name": "punctuation.definition.comment.szl" } }
        },
        "boilerplate": {
            "comment": "From code, ]@ switches to literal text which is output verbatim until the next @[",
            "begin": "\\]@",
            "beginCaptures": { "0": { "name": "punctuation.section.embedded.end.szl" } },
            "end": "@\\[",
            "endCaptures": { "0": { "name": "punctuation.section.embedded.begin.szl" } },
            "contentName": "string.unquoted.boilerplate.szl"
        },
        "string": {
            "begin": "\"",
            "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.szl" } },
            "end": "(\")|$",
            "endCaptures": { "1": { "name": "punctuation.definition.string.end.szl" } },
            "name": "string.quoted.double.szl",
            "patterns": [
                {
                    "match": "\\\\(?:[nrt\"\\\\\\n]|0[0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
                    "name": "constant.character.escape.szl"
                },
                {
                    "match": "\\\\.",
                    "name": "invalid.illegal.escape.szl"
                },
                {
                    "comment": "printf/scanf format specifiers",
                    "match": "%(?:%|[-+ #0]*(?:[0-9]+|\\*)?(?:\\.(?:[0-9]+|\\*))?[diouxXeEfFgGcs])",
                    "name": "constant.other.placeholder.szl"
                }
            ]
        },
        "number": {
            "patterns": [
                {
                    "match": "\\b0[xX][0-9A-Fa-f]+\\b",
                    "name": "constant.numeric.hex.szl"
                },
                {
                    "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?",
                    "name": "constant.numeric.decimal.szl"
                }
            ]
        },
        "function-definition": {
            "begin": "\\b(function)\\s+([A-Za-z][A-Za-z0-9_]*)\\s*(\\()",
            "beginCaptures": {
                "1": { "name": "storage.type.function.szl" },
                "2": { "name": "entity.name.function.szl" },
                "3": { "name": "punctuation.definition.parameters.begin.szl" }
            },
            "end": "\\)",
            "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.szl" } },
            "name": "meta.function.szl",
            "patterns": [
                { "include": "#comment" },
                { "match": "[A-Za-z][A-Za-z0-9_]*", "name": "variable.parameter.szl" },
                { "match": ",", "name": "punctuation.separator.parameter.szl" }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "match": "\\b(?:if|else|elseif|elsif|for|in|while|break|continue|return|end)\\b",
                    "name": "keyword.control.szl"
                },
                {
                    "match": "\\bINCLUDE\\b",
                    "name": "keyword.control.import.szl"
                },
                {
                    "match": "\\bfunction\\b",
                    "name": "storage.type.function.szl"
                },
                {
                    "match": "\\blocal\\b",
                    "name": "storage.modifier.local.szl"
                },
                {
                    "match": "\\b(?:new|delete)\\b",
                    "name": "keyword.operator.object.szl"
                }
            ]
        },
        "constant": {
            "patterns": [
                {
                    "match": "\\b(?:true|false|null|Pi)\\b",
                    "name": "constant.language.szl"
                },
                {
                    "match": "\\b(?:frame|axisMode|rotOrder)\\b",
                    "name": "variable.language.szl"
                }
            ]
        },
        "builtin": {
            "patterns": [
                {
                    "comment": "Global object lists and pseudo-objects",
                    "match": "\\b(?:Cam|ColorPref|Constraint|Curve|Extra|Flex|FolderPref|Global|Lite|Mesh|MockPreset|Note|Obj|Output|Phase|Pref|Scene|Shot|Trk|WFPreset)\\b",
                    "name": "support.class.szl"
                },
                {
                    "match": "\\b(?:abs|atan|atan2|atof|atoi|binaryinp|ceil|closeinp|closeout|CopyFile|cos|DateTime|DeleteFile|Demangle|exit|exp|explode|fabs|floor|fmax|fmin|getenv|getline|IdentityMap|IncrementFileName|index|isNull|length|log|Mangle|MatchTemplateWithVars|Message|MutableList|NewDialog|Offset|openinp|openout|Point|pow|printf|random|RenumberFileName|rindex|RotX|RotY|RotZ|round|scanf|sin|SplineInterpolator|sprintf|sqrt|sscanf|strreplace|substr|system|tan|Transform|translate|typeof|utf8char|utf8errors|utf8from1252|utf8index|utf8length|utf8ord|utf8substr|utf8to1252|utf8translate|Vector|YesNoCancel)\\b(?=\\s*\\()",
                    "name": "support.function.builtin.szl"
                }
            ]
        },
        "function-call": {
            "match": "\\b[A-Za-z][A-Za-z0-9_]*(?=\\s*\\()",
            "name": "entity.name.function.call.szl"
        },
        "member": {
            "patterns": [
                {
                    "match": "(\\.)\\s*([A-Za-z][A-Za-z0-9_]*)(?=\\s*\\()",
                    "captures": {
                        "1": { "name": "punctuation.accessor.szl" },
                        "2": { "name": "entity.name.function.member.szl" }
                    }
                },
                {
                    "match": "(\\.)\\s*(\\$)?([A-Za-z][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "punctuation.accessor.szl" },
                        "2": { "name": "keyword.operator.indirection.szl" },
                        "3": { "name": "variable.other.property.szl" }
                    }
                }
            ]
        },
        "operator": {
            "patterns": [
                { "match": "\\*\\*", "name": "keyword.operator.arithmetic.power.szl" },
                { "match": "\\+\\+|--", "name": "keyword.operator.increment-decrement.szl" },
                { "match": "<<|>>", "name": "keyword.operator.bitwise.shift.szl" },
                { "match": "==|!=|<=|>=|<|>", "name": "keyword.operator.comparison.szl" },
                { "match": "&&|\\|\\||!", "name": "keyword.operator.logical.szl" },
                { "match": "[-+*/&|^]?=", "name": "keyword.operator.assignment.szl" },
                { "match": "[-+*/%]", "name": "keyword.operator.arithmetic.szl" },
                { "match": "[&|^~]", "name": "keyword.operator.bitwise.szl" },
                { "match": "#", "name": "keyword.operator.count.szl" },
                { "match": "\\$", "name": "keyword.operator.indirection.szl" },
                { "match": "[?:]", "name": "keyword.operator.ternary.szl" }
            ]
        },
        "punctuation": {
            "patterns": [
                { "match": ",", "name": "punctuation.separator.comma.szl" },
                { "match": ";", "name": "punctuation.terminator.statement.szl" },
                { "match": "[()]", "name": "meta.brace.round.szl" },
                { "match": "[\\[\\]]", "name": "meta.brace.square.szl" }
            ]
        }
    }
}
